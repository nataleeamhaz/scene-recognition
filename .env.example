ANTHROPIC_API_KEY=sk-ant-...

# From your Pinterest app's "My apps" page after it's created
PINTEREST_APP_ID=your_pinterest_app_id
PINTEREST_APP_SECRET=your_pinterest_app_secret
PINTEREST_REDIRECT_URI=http://localhost:8000/callback

# Obtained by visiting /pinterest/login locally and completing the OAuth
# flow — the /callback route will print the token to paste here.
PINTEREST_ACCESS_TOKEN=your_pinterest_token_here

# From your Decor8 AI account (https://decor8.ai/api-docs) — pay-as-you-go,
# $0.20/image, used by /generate-photo for the final redesigned-room photo.
DECOR8_API_KEY=your_decor8_api_key_here

# This app's own publicly-reachable base URL (e.g. your Render URL, or a
# local tunnel like ngrok). Required for /generate-photo — Decor8's servers
# fetch the uploaded photo from {PUBLIC_BASE_URL}/tmp-image/{id}.jpg, so
# plain localhost will not work here.
PUBLIC_BASE_URL=https://your-app.onrender.com
